# ============================================
# PlanAgent Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to git!

# Core API Keys (Required)
# ========================

# OpenAI API Key (for Planner)
OPENAI_API_KEY=sk-...

# Anthropic API Key (for Executor agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MCP Server API Keys (Optional)
# ===============================

# Brave Search (for web_search MCP tool)
# Get your API key from: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# GitHub Personal Access Token (for GitHub MCP server - HTTP/stdio)
# Generate a token from: https://github.com/settings/tokens
# Recommended scopes: repo, read:user, read:org, workflow, issues, pull_requests
# For remote server (HTTP): Use this token
# For local server (stdio): Also use this token
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# Postgres (for database MCP server)
# Example: postgresql://user:password@localhost:5432/dbname
POSTGRES_CONNECTION_STRING=your_postgres_connection_here

# Model Configuration
# ===================

# OpenAI Model (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Storage
# =======

ARTIFACTS_PATH=./artifacts

# Limits
# ======

MAX_ITERATIONS_PER_STEP=15
DEFAULT_TIMEOUT_S=180
MAX_TOKENS_PER_CALL=4096
